# Alongside — environment variables.
# Copy to .env in the repository root. No secrets belong in this file.

# ---------------------------------------------------------------- backend
PORT=4000
HOST=0.0.0.0

# Where SQLite and uploaded media live. Relative paths resolve from apps/server.
ALONGSIDE_DATA_DIR=data

# The caregiver dashboard's bearer token. This build has one household and one
# caregiver; in production this is where a real sign-in belongs.
ALONGSIDE_CAREGIVER_TOKEN=dev-caregiver-token

# ------------------------------------------------------------ AI provider
# local    deterministic rules, needs no credentials, used for the demo
# anthropic  Claude via the Anthropic Messages API
# bedrock    Claude via Amazon Bedrock (Converse API)
ALONGSIDE_AI_PROVIDER=local

# Only read when ALONGSIDE_AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Only read when ALONGSIDE_AI_PROVIDER=bedrock. Credentials come from the
# standard AWS chain (environment, shared config, instance role).
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# ------------------------------------------------------------------- MCP
# Comma-separated Origin values allowed to call /mcp from a browser.
# localhost is always allowed. Leave empty for non-browser MCP clients.
ALONGSIDE_MCP_ALLOWED_ORIGINS=

# ------------------------------------------------------------- scheduling
# How often the server sweeps for due routines, in milliseconds.
ALONGSIDE_SCHEDULER_INTERVAL_MS=5000
# How late a reminder may still be announced, in minutes.
ALONGSIDE_ANNOUNCE_GRACE_MINUTES=45
# How long after an announcement with no reply an occurrence is recorded as
# "completion unconfirmed", in minutes. This is a record, never an alert.
ALONGSIDE_UNCONFIRMED_AFTER_MINUTES=120

# ------------------------------------------------------------------- demo
# Timezone for the seeded demo household.
ALONGSIDE_DEMO_TIMEZONE=America/New_York

# ------------------------------------------------------------- web client
# Backend the Vite dev server proxies to.
ALONGSIDE_BACKEND=http://localhost:4000
